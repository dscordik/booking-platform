# URL базы данных. Для локальной разработки используется SQLite.
# При деплое на Render замените на Internal Database URL вашего PostgreSQL.
DATABASE_URL=sqlite:///./app.db

# Секретный ключ для генерации JWT токенов.
# Сгенерируйте его командой: python -c "import secrets; print(secrets.token_urlsafe(32))"
# и вставьте полученное значение ниже вместо пустой строки.
SECRET_KEY=

# Время жизни access токена в минутах
ACCESS_TOKEN=30

# Алгоритм шифрования JWT
ALGORITHM=HS256